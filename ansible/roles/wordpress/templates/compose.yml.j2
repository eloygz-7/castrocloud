# Xerado por Ansible · ct-web: WordPress (PHP-FPM), Nginx e MySQL
name: wordpress

x-bd: &bd
  WORDPRESS_DB_HOST: db
  WORDPRESS_DB_NAME: wordpress
  WORDPRESS_DB_USER: wordpress
  WORDPRESS_DB_PASSWORD: ${MYSQL_PASSWORD}

services:
  db:
    image: {{ imaxe_mysql }}
    restart: unless-stopped
    command: {{ mysql_axustes }}
    environment:
      TZ: {{ zona_horaria }}
      MYSQL_DATABASE: wordpress
      MYSQL_USER: wordpress
      MYSQL_PASSWORD: ${MYSQL_PASSWORD}
      MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD}
    volumes:
      - mysql:/var/lib/mysql

  app:
    image: {{ imaxe_wordpress }}
    restart: unless-stopped
    depends_on: [db]
    environment:
      <<: *bd
      TZ: {{ zona_horaria }}
      # Os enlaces da web usan o enderezo polo que se entra (IP interna ou
      # IP pública por HTTPS); e non se poden editar plugins nin temas desde
      # o panel, por se alguén entrase de fóra.
      WORDPRESS_CONFIG_EXTRA: |
        if (!empty($$_SERVER['HTTP_HOST'])) {
          $$esquema = (!empty($$_SERVER['HTTPS']) && $$_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
          define('WP_HOME', $$esquema . '://' . $$_SERVER['HTTP_HOST']);
          define('WP_SITEURL', WP_HOME);
        }
        define('DISALLOW_FILE_EDIT', true);
    volumes:
      - wordpress:/var/www/html

  web:
    image: {{ imaxe_nginx }}
    restart: unless-stopped
    depends_on: [app]
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./tls:/etc/nginx/tls:ro
      - wordpress:/var/www/html:ro

  # WP-CLI: non queda acendido, só se usa con «docker compose run --rm cli wp ...».
  # Mesmo usuario (www-data, 33) que a imaxe de PHP-FPM para non romper permisos.
  cli:
    image: {{ imaxe_wpcli }}
    profiles: [cli]
    user: "33:33"
    depends_on: [db]
    environment:
      <<: *bd
    volumes:
      - wordpress:/var/www/html

volumes:
  mysql:
  wordpress:
