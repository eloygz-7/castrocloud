# Copiar como terraform.tfvars e pór o token real.
# terraform.tfvars está en .gitignore: o token NON se sube a git.
proxmox_api_token = "terraform@pve!provider=00000000-0000-0000-0000-000000000000"

# Copias: un Proxmox Backup Server en cada nodo. configurar-pbs.sh mostra en cada
# nodo a súa liña de "pbs" e de "pbs_segredos". Mentres non se descomenten,
# Terraform non crea as copias.
# pbs = {
#   pve1 = { servidor = "192.168.0.211", pegada = "aa:bb:cc:..." }
#   pve2 = { servidor = "192.168.0.212", pegada = "aa:bb:cc:..." }
#   pve3 = { servidor = "192.168.0.213", pegada = "aa:bb:cc:..." }
# }
# pbs_segredos = {
#   pve1 = "00000000-0000-0000-0000-000000000000"
#   pve2 = "00000000-0000-0000-0000-000000000000"
#   pve3 = "00000000-0000-0000-0000-000000000000"
# }

# Por defecto úsase a wifi da casa (192.168.0.0/24). Se a demo vai noutra wifi
# (por exemplo, o punto de acceso do móbil), descomentar e cambiar as IP:
# proxmox_endpoint = "https://192.168.43.211:8006/"
# pasarela         = "192.168.43.1"
# contedores = {
#   ct-pve1-1 = { nodo = "pve1", vm_id = 201, ip = "192.168.43.221" }
#   ct-pve1-2 = { nodo = "pve1", vm_id = 202, ip = "192.168.43.222" }
#   ct-pve1-3 = { nodo = "pve1", vm_id = 203, ip = "192.168.43.223" }
#   ct-pve2-1 = { nodo = "pve2", vm_id = 204, ip = "192.168.43.224" }
#   ct-pve2-2 = { nodo = "pve2", vm_id = 205, ip = "192.168.43.225" }
#   ct-pve3-1 = { nodo = "pve3", vm_id = 206, ip = "192.168.43.226" }
#   ct-pve3-2 = { nodo = "pve3", vm_id = 207, ip = "192.168.43.227" }
#   ct-pve3-3 = { nodo = "pve3", vm_id = 208, ip = "192.168.43.228" }
# }
